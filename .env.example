# Environment variables for LDAPGuard

# Docker Image Version
# Specify which version of LDAPGuard images to use
# Options: latest, 1.0.1, 1.0.0, sha-abc123, etc.
IMAGE_TAG=latest

# PostgreSQL
POSTGRES_PASSWORD=changeme

# Application
# APP_NAME=LDAPGuard
# APP_VERSION=1.0.0
DEBUG=false

# Application Security
SECRET_KEY=your-secret-key-minimum-32-characters-long
ENCRYPTION_KEY=your-encryption-key-32-bytes-minimum-for-aes256
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Connection
DATABASE_URL=postgresql+asyncpg://ldapguard:changeme@postgres:5432/ldapguard

# Redis
REDIS_URL=redis://redis:6379

# LDAP Configuration (optional - can be configured per server via API)
# LDAP_SERVER=ldap.example.com
# LDAP_PORT=389
# LDAP_USE_SSL=false
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=admin_password

# Backup Settings
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=30
INCREMENTAL_BACKUP_ENABLED=true

# Backup Retry Logic
# Automatically retry failed backups with exponential backoff
BACKUP_RETRY_ENABLED=true
BACKUP_MAX_RETRIES=3
BACKUP_RETRY_DELAY=300  # Initial delay in seconds (5 minutes)
BACKUP_RETRY_BACKOFF=2.0  # Exponential backoff multiplier (delay *= backoff * attempts)
# Example retry schedule with default settings:
#   Attempt 1: Failed  
#   Attempt 2: After 5 minutes (300s * 2.0^0)
#   Attempt 3: After 10 minutes (300s * 2.0^1)
#   Attempt 4: After 20 minutes (300s * 2.0^2)
#   Final: Give up after 3 retries

# Backup Verification & Integrity Checks
# Automatically verify backup integrity using checksums and LDIF syntax validation
BACKUP_VERIFY_ON_COMPLETION=true  # Verify backups immediately after creation
BACKUP_VERIFY_BEFORE_RESTORE=true  # Verify backups before restoring (prevents corrupted restores)
BACKUP_CHECKSUM_ALGORITHM=sha256  # Hash algorithm: sha256 (default), sha512, or md5
# Verification includes:
#   - Checksum validation (file hasn't been corrupted or tampered with)
#   - File size verification
#   - LDIF syntax validation (ensures file is valid LDAP data)
#   - File accessibility check

# S3-Compatible Cloud Storage Integration
# Automatically upload backups to S3-compatible cloud storage (AWS S3, MinIO, Backblaze B2, Wasabi, etc.)
S3_ENABLED=false
# S3_BUCKET_NAME=ldapguard-backups
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_REGION=us-east-1

# S3 Endpoint URL (required for non-AWS providers)
# For AWS S3: Leave commented (uses default AWS endpoints)
# For MinIO: http://minio:9000 or https://minio.example.com
# For Backblaze B2: https://s3.us-west-001.backblazeb2.com
# For Wasabi: https://s3.wasabisys.com or https://s3.us-east-2.wasabisys.com
# For DigitalOcean Spaces: https://nyc3.digitaloceanspaces.com
# S3_ENDPOINT_URL=http://minio:9000

# S3 Storage Class
# AWS S3: STANDARD (default), GLACIER, INTELLIGENT_TIERING, STANDARD_IA, ONEZONE_IA
# MinIO/Backblaze: STANDARD (default)
S3_STORAGE_CLASS=STANDARD

# Automatic Upload & Cleanup
S3_AUTO_UPLOAD=true  # Automatically upload backups after creation
S3_AUTO_DELETE_LOCAL=false  # Delete local backup after successful cloud upload
S3_KEEP_LAST_LOCAL=3  # Keep last N local backups even if S3_AUTO_DELETE_LOCAL=true

# Example configurations:
#
# AWS S3:
#   S3_ENABLED=true
#   S3_BUCKET_NAME=my-ldap-backups
#   S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
#   S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
#   S3_REGION=us-east-1
#   # S3_ENDPOINT_URL not needed for AWS
#
# MinIO (self-hosted):
#   S3_ENABLED=true
#   S3_BUCKET_NAME=ldapguard
#   S3_ACCESS_KEY_ID=minioadmin
#   S3_SECRET_ACCESS_KEY=minioadmin
#   S3_REGION=us-east-1
#   S3_ENDPOINT_URL=http://minio:9000
#
# Backblaze B2:
#   S3_ENABLED=true
#   S3_BUCKET_NAME=my-bucket
#   S3_ACCESS_KEY_ID=your-key-id
#   S3_SECRET_ACCESS_KEY=your-app-key
#   S3_REGION=us-west-001
#   S3_ENDPOINT_URL=https://s3.us-west-001.backblazeb2.com

# Webhooks (optional)
WEBHOOK_ENABLED=false
# WEBHOOK_URL=https://your-webhook-endpoint.com/notify

# Email Notifications (optional)
# Enable email notifications for backup/restore operations
EMAIL_ENABLED=false

# SMTP Configuration
# For Gmail (with app-specific password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#   SMTP_USE_SSL=false
#   SMTP_USERNAME=your-email@gmail.com
#   SMTP_PASSWORD=your-app-specific-password
#
# For SendGrid:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#   SMTP_USE_SSL=false
#   SMTP_USERNAME=apikey
#   SMTP_PASSWORD=your-sendgrid-api-key
#
# For Office 365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#   SMTP_USE_SSL=false
#   SMTP_USERNAME=your-email@domain.com
#   SMTP_PASSWORD=your-password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password

# Email Sender Information
EMAIL_FROM=noreply@ldapguard.local
EMAIL_FROM_NAME=LDAPGuard

# Application URL (used in email links)
APP_URL=http://localhost:3000

# Prometheus Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Application
# (DEBUG is set above)